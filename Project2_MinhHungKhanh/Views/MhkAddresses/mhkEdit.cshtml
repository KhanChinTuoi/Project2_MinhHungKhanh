@model Project2_MinhHungKhanh.Models.MhkAddress

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>MhkAddress</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="MhkEdit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MhkAddressId" />
            <div class="form-group">
                <label asp-for="MhkUserId" class="control-label"></label>
                <select asp-for="MhkUserId" class="form-control" asp-items="ViewBag.MhkUserId"></select>
                <span asp-validation-for="MhkUserId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MhkLine1" class="control-label"></label>
                <input asp-for="MhkLine1" class="form-control" />
                <span asp-validation-for="MhkLine1" class="text-danger"></span>
            </div>
            <div class="text-center">
                <button type="submit" class="btn btn-primary">💾 Lưu thay đổi</button>
                <a asp-action="MhkIndex">⬅️ Quay lai</a>
            </div>
        </form>
    </div>
</div>


