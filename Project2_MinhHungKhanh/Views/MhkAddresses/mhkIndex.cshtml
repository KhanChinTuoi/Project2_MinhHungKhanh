@model IEnumerable<Project2_MinhHungKhanh.Models.MhkAddress>

@{
    ViewData["Title"] = "Danh sách địa chỉ";
}

<h1>Danh sách địa chỉ</h1>

<p>
    <a asp-action="MhkCreate" class="btn btn-success">➕ Tạo mới</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã địa chỉ</th>
            <th>Mã người dùng</th>
            <th>Dòng địa chỉ</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MhkAddressId</td>
                <td>@item.MhkUserId</td>
                <td>@item.MhkLine1</td>
                <td>
                    <a asp-action="MhkEdit" asp-route-id="@item.MhkAddressId" class="btn btn-warning btn-sm">Sửa</a> |
                    <a asp-action="MhkDelete" asp-route-id="@item.MhkAddressId" class="btn btn-danger btn-sm">Xóa</a> |
                    <a asp-action="MhkDetails" asp-route-id="@item.MhkAddressId" class="btn btn-info btn-sm">Chi tiết</a>
                </td>
            </tr>
        }
    </tbody>
</table>
