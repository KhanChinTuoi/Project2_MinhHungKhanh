@model Project2_MinhHungKhanh.Models.MhkCategory

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>MhkCategory</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="mhkEdit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MhkCategoryId" />
            <div class="form-group">
                <label asp-for="MhkCategoryName" class="control-label"></label>
                <input asp-for="MhkCategoryName" class="form-control" />
                <span asp-validation-for="MhkCategoryName" class="text-danger"></span>
            </div>
            <div class="text-center">
                <button type="submit" class="btn btn-primary">💾 Lưu thay đổi</button>
                <a asp-action="mhkIndex">⬅️ Quay lai</a>
            </div>
        </form>
    </div>
</div>


