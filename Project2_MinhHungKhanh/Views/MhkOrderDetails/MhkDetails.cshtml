@model Project2_MinhHungKhanh.Models.MhkOrderDetail

@{
    ViewData["Title"] = "Details";
}

<div class="card shadow-sm mx-auto mt-4" style="max-width: 600px;">
    <div class="card-header bg-primary text-white text-center">
        <h3>@ViewData["Title"]</h3>
</div>


<div>
    <h4>MhkOrderDetail</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MhkQuantity)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MhkQuantity)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MhkUnitPrice)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MhkUnitPrice)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MhkOrder)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MhkOrder.MhkOrderId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MhkProduct)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MhkProduct.MhkProductId)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="MhkEdit" asp-route-mhkid="@Model?.MhkOrderDetailId">Edit</a> |
    <a asp-action="MhkIndex">Quay lai</a>
</div>
