@model IEnumerable<Project2_MinhHungKhanh.Models.MhkOrderDetail>

@{
    ViewData["Title"] = "Index";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="MhkCreate" class="btn btn-primary">➕Them moi</a>
</p>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MhkQuantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MhkUnitPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MhkOrder)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MhkProduct)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MhkQuantity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MhkUnitPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MhkOrder.MhkOrderId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MhkProduct.MhkProductId)
            </td>
            <td>
                    <a asp-action="MhkEdit" asp-route-mhkid="@item.MhkOrderDetailId" class="btn btn-primary">✏️Edit</a>
                    <a asp-action="MhkDetails" asp-route-mhkid="@item.MhkOrderDetailId" class="btn btn-warning">🔎Details</a>
                    <a asp-action="MhkDelete" asp-route-mhkid="@item.MhkOrderDetailId" class="btn btn-danger">🗑️Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
