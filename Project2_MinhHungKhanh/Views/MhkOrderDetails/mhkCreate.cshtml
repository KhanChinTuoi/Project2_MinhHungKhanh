@model Project2_MinhHungKhanh.Models.MhkOrderDetail

<h1>Tạo mới</h1>

<form asp-action="MhkCreate" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="MhkOrderId"></label>
        <select asp-for="MhkOrderId" class="form-control" asp-items="ViewBag.MhkOrderId"></select>
    </div>

    <div class="form-group">
        <label asp-for="MhkProductId"></label>
        <select asp-for="MhkProductId" class="form-control" asp-items="ViewBag.MhkProductId"></select>
    </div>

    <div class="form-group">
        <label asp-for="MhkQuantity"></label>
        <input asp-for="MhkQuantity" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="MhkUnitPrice"></label>
        <input asp-for="MhkUnitPrice" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">💾 Lưu</button>
    <a asp-action="MhkIndex" class="btn btn-secondary">⬅ Quay lại</a>
</form>
