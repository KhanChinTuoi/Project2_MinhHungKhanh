@model Project2_MinhHungKhanh.Models.MhkOrderDetail

@{
    ViewData["Title"] = "Chi tiết ";
}

<h1>Chi tiết MhkOrderDetail</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">MhkOrderId</dt>
        <dd class="col-sm-10">@Model.MhkOrderId</dd>

        <dt class="col-sm-2">MhkProduct</dt>
        <dd class="col-sm-10">@Model.MhkProduct.MhkName</dd>

        <dt class="col-sm-2">MhkQuantity</dt>
        <dd class="col-sm-10">@Model.MhkQuantity</dd>

        <dt class="col-sm-2">MhkUnitPrice</dt>
        <dd class="col-sm-10">@Model.MhkUnitPrice</dd>
    </dl>
</div>
<a asp-action="MhkEdit" asp-route-id="@Model.MhkOrderDetailId" class="btn btn-warning">✏️ Sửa</a>
<a asp-action="MhkIndex" class="btn btn-secondary">⬅ Quay lại</a>
