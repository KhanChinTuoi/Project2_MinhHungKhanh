@model Project2_MinhHungKhanh.Models.MhkOrderDetail

@{
    ViewData["Title"] = "Chỉnh sửa ";
}

<h1>Chỉnh sửa MhkOrderDetail</h1>

<form asp-action="MhkEdit">
    <input type="hidden" asp-for="MhkOrderDetailId" />
    <div class="form-group">
        <label asp-for="MhkOrderId" class="control-label"></label>
        <select asp-for="MhkOrderId" class="form-control" asp-items="ViewBag.MhkOrderId"></select>
    </div>
    <div class="form-group">
        <label asp-for="MhkProductId" class="control-label"></label>
        <select asp-for="MhkProductId" class="form-control" asp-items="ViewBag.MhkProductId"></select>
    </div>
    <div class="form-group">
        <label asp-for="MhkQuantity" class="control-label"></label>
        <input asp-for="MhkQuantity" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="MhkUnitPrice" class="control-label"></label>
        <input asp-for="MhkUnitPrice" class="form-control" />
    </div>
    <br />
    <button type="submit" class="btn btn-warning">💾 Cập nhật</button>
    <a asp-action="MhkIndex" class="btn btn-secondary">⬅ Quay lại</a>
</form>
