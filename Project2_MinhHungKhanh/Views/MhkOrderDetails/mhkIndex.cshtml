@model IEnumerable<Project2_MinhHungKhanh.Models.MhkOrderDetail>

@{
    ViewData["Title"] = "Index";
}

<h1>Danh sách </h1>

<p>
    <a asp-action="MhkCreate">➕ Thêm mới</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>MhkOrderId</th>
            <th>MhkProduct</th>
            <th>MhkQuantity</th>
            <th>MhkUnitPrice</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MhkOrderId</td>
                <td>@item.MhkProduct.MhkName</td>
                <td>@item.MhkQuantity</td>
                <td>@item.MhkUnitPrice</td>
                <td>
                    <a asp-action="MhkEdit" asp-route-id="@item.MhkOrderDetailId">✏️ Sửa</a> |
                    <a asp-action="MhkDetails" asp-route-id="@item.MhkOrderDetailId">🔎 Xem</a> |
                    <a asp-action="MhkDelete" asp-route-id="@item.MhkOrderDetailId">🗑️ Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
