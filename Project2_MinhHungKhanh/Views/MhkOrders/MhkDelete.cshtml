@model Project2_MinhHungKhanh.Models.MhkOrder

@{
    ViewData["Title"] = "Delete";
}

<div class="card shadow-sm mx-auto mt-4" style="max-width: 600px;">
    <div class="card-header bg-danger text-white">
        <h4 class="text-center">Bạn có chắc muốn xóa don hang nay ko?</h4>

</div>
<div>
    <h4>MhkOrder</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MhkOrderDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MhkOrderDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MhkStatus)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MhkStatus)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MhkUser)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MhkUser.MhkUserId)
        </dd>
    </dl>
    
    <form asp-action="MhkDelete">
        <input type="hidden" asp-for="MhkOrderId" />
        <button type="submit" class="btn btn-danger">🗑️ Xác nhận xóa</button>
        <a asp-action="HqmIndex" class="btn btn-secondary">⬅️ Quay lại</a>
    </form>
</div>