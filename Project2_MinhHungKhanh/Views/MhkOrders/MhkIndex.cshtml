@model IEnumerable<Project2_MinhHungKhanh.Models.MhkOrder>

@{
    ViewData["Title"] = "Index";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="MhkCreate" class="btn btn-primary">➕Them moi</a>
</p>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MhkOrderDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MhkStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MhkUser)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MhkOrderDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MhkStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MhkUser.MhkUserId)
            </td>
            <td>
                    <a asp-action="MhkEdit" asp-route-mhkid="@item.MhkOrderId" class="btn btn-success">✏️Edit</a>
                    <a asp-action="MhkDetails" asp-route-mhkid="@item.MhkOrderId" class="btn btn-warning">🔎Details</a>
                    <a asp-action="MhkDelete" asp-route-mhkid="@item.MhkOrderId" class="btn btn-danger">🗑️Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
