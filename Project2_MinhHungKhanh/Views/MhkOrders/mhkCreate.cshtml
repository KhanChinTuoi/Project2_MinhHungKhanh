@model Project2_MinhHungKhanh.Models.MhkOrder

@{
    ViewData["Title"] = "Tạo mới đơn hàng";
}

<h1>Tạo mới đơn hàng</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="MhkCreate">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="MhkUserId" class="control-label"></label>
                <select asp-for="MhkUserId" class ="form-control" asp-items="ViewBag.MhkUserId"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="MhkIndex">Quay về danh sách</a>
</div>

