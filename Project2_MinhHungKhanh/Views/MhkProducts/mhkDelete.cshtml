@model Project2_MinhHungKhanh.Models.MhkProduct

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<h1>Xóa sản phẩm</h1>

<h3>Bạn có chắc muốn xóa sản phẩm này?</h3>
<div>
    <h4>@Model.MhkName</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Loại sản phẩm</dt>
        <dd class="col-sm-9">@Model.MhkCategory.MhkCategoryName</dd>

        <dt class="col-sm-3">Giá</dt>
        <dd class="col-sm-9">@Model.MhkPrice</dd>

        <dt class="col-sm-3">Mô tả</dt>
        <dd class="col-sm-9">@Model.MhkDescription</dd>
    </dl>

    <form asp-action="MhkDelete">
        <input type="hidden" asp-for="MhkProductId" />
        <input type="submit" value="🗑️ Xóa" class="btn btn-danger" />
        <a asp-action="MhkIndex" class="btn btn-secondary">⬅️ Quay lại</a>
    </form>
</div>
