@model Project2_MinhHungKhanh.Models.MhkProduct

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<h1>Chỉnh sửa sản phẩm</h1>

<h4>MhkProduct</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="MhkEdit">
            <input type="hidden" asp-for="MhkProductId" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="MhkCategoryId" class="control-label">Loại sản phẩm</label>
                <select asp-for="MhkCategoryId" class="form-control" asp-items="ViewBag.MhkCategoryId"></select>
            </div>

            <div class="form-group">
                <label asp-for="MhkName" class="control-label">Tên sản phẩm</label>
                <input asp-for="MhkName" class="form-control" />
                <span asp-validation-for="MhkName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MhkPrice" class="control-label">Giá</label>
                <input asp-for="MhkPrice" class="form-control" />
                <span asp-validation-for="MhkPrice" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MhkDescription" class="control-label">Mô tả</label>
                <textarea asp-for="MhkDescription" class="form-control"></textarea>
                <span asp-validation-for="MhkDescription" class="text-danger"></span>
            </div>

            <br />
            <div class="form-group">
                <input type="submit" value="💾 Lưu thay đổi" class="btn btn-success" />
                <a asp-action="MhkIndex" class="btn btn-secondary">⬅️ Quay lại</a>
            </div>
        </form>
    </div>
</div>
