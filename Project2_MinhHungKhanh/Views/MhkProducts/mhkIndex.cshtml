@model IEnumerable<Project2_MinhHungKhanh.Models.MhkProduct>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Danh sách sản phẩm</h3>
            <a asp-action="mhkCreate" class="btn btn-light btn-sm">
                <i class="bi bi-plus-circle"></i> Thêm mới
            </a>
        </div>
        <div class="card-body p-4">
            <table class="table table-hover align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th>Tên</th>
                        <th>Giá</th>
                        <th>Mô tả</th>
                        <th>Số lượng</th>
                        <th style="width: 220px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.MhkName)</td>
                            <td>@Html.DisplayFor(modelItem => item.MhkPrice)</td>
                            <td>@Html.DisplayFor(modelItem => item.MhkDescription)</td>
                            <td>@Html.DisplayFor(modelItem => item.MhkCategory.MhkCategoryId)</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="mhkEdit" asp-route-id="@item.MhkProductId" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <a asp-action="mhkDetails" asp-route-id="@item.MhkProductId" class="btn btn-sm btn-info text-white">
                                        <i class="bi bi-info-circle"></i> Details
                                    </a>
                                    <a asp-action="mhkDelete" asp-route-id="@item.MhkProductId" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
