@model IEnumerable<Project2_MinhHungKhanh.Models.MhkProduct>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<h1>Danh sách sản phẩm</h1>

<p>
    <a asp-action="MhkCreate">➕ Thêm sản phẩm</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.MhkName)</th>
            <th>@Html.DisplayNameFor(model => model.MhkPrice)</th>
            <th>@Html.DisplayNameFor(model => model.MhkDescription)</th>
            <th>Loại sản phẩm</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MhkName</td>
                <td>@item.MhkPrice</td>
                <td>@item.MhkDescription</td>
                <td>@item.MhkCategory.MhkCategoryName</td>
                <td>
                    <a asp-action="MhkEdit" asp-route-id="@item.MhkProductId">✏️ Sửa</a> |
                    <a asp-action="MhkDetails" asp-route-id="@item.MhkProductId">🔍 Chi tiết</a> |
                    <a asp-action="MhkDelete" asp-route-id="@item.MhkProductId">🗑️ Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
