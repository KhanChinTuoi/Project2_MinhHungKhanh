@model Project2_MinhHungKhanh.Models.MhkUser

@{
    ViewData["Title"] = "Edit User";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-warning text-dark text-center">
                    <h3 class="mb-0">Edit User</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="MhkUserId" />

                        <div class="mb-3">
                            <label asp-for="MhkFullName" class="form-label fw-bold"></label>
                            <input asp-for="MhkFullName" class="form-control" placeholder="Enter full name" />
                            <span asp-validation-for="MhkFullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MhkEmail" class="form-label fw-bold"></label>
                            <input asp-for="MhkEmail" class="form-control" placeholder="Enter email address" />
                            <span asp-validation-for="MhkEmail" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-center gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-save"></i> Save
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
