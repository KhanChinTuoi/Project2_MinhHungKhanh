@model Project2_MinhHungKhanh.Models.MhkUser

@{
    ViewData["Title"] = "Thêm mới người dùng";
}

<h1>Thêm mới người dùng</h1>

<form asp-action="MhkCreate">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="MhkFullName" class="control-label">Họ tên</label>
        <input asp-for="MhkFullName" class="form-control" />
        <span asp-validation-for="MhkFullName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MhkEmail" class="control-label">Email</label>
        <input asp-for="MhkEmail" class="form-control" />
        <span asp-validation-for="MhkEmail" class="text-danger"></span>
    </div>

    <br />
    <input type="submit" value="💾 Lưu" class="btn btn-success" />
    <a asp-action="MhkIndex" class="btn btn-secondary">⬅️ Quay lại</a>
</form>
