@model Project2_MinhHungKhanh.Models.MhkUser

@{
    ViewData["Title"] = "Xóa người dùng";
}

<h1>Xóa người dùng</h1>

<h3>Bạn có chắc muốn xóa người dùng này?</h3>
<div>
    <h4>@Model.MhkFullName</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.MhkEmail</dd>
    </dl>

    <form asp-action="MhkDelete">
        <input type="hidden" asp-for="MhkUserId" />
        <input type="submit" value="🗑️ Xóa" class="btn btn-danger" />
        <a asp-action="MhkIndex" class="btn btn-secondary">⬅️ Quay lại</a>
    </form>
</div>
