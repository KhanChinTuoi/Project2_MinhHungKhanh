@model Project2_MinhHungKhanh.Models.MhkUser

@{
    ViewData["Title"] = "Chi tiết người dùng";
}

<h1>Chi tiết người dùng</h1>

<div>
    <h4>@Model.MhkFullName</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Họ tên</dt>
        <dd class="col-sm-9">@Model.MhkFullName</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.MhkEmail</dd>

        <dt class="col-sm-3">Số địa chỉ</dt>
        <dd class="col-sm-9">@Model.MhkAddresses.Count()</dd>

        <dt class="col-sm-3">Số đơn hàng</dt>
        <dd class="col-sm-9">@Model.MhkOrders.Count()</dd>
    </dl>
</div>
<div>
    <a asp-action="MhkEdit" asp-route-id="@Model.MhkUserId" class="btn btn-warning">✏️ Sửa</a> |
    <a asp-action="MhkIndex" class="btn btn-secondary">⬅️ Quay lại</a>
</div>
