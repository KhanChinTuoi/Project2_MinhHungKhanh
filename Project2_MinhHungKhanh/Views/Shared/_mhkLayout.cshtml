<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Project2_MinhHungKhanh</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Project2_MinhHungKhanh.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <partial name="_mhkNavBar"/> 
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-light pt-4 pb-2 mt-5">
        <div class="container">


            <div class="row">
                <div class="mb-4">
                    <img src="~/images/logo1.jpg" alt="MHK Cafe" style="height: 100px;">
                </div>

                <div class="col-md-4">
                    <h5>MHK Cafe</h5>
                    <p>Đem đến cho bạn hương vị cà phê đậm chất Việt.</p>
                </div>

                <div class="col-md-4">
                    <h5>Liên kết</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-light text-decoration-none">Trang chủ</a></li>
                        <li><a href="#" class="text-light text-decoration-none">Thông tin</a></li>
                        <li><a href="#" class="text-light text-decoration-none">Đơn hàng</a></li>
                        <li><a href="#" class="text-light text-decoration-none">Liên hệ</a></li>
                        <li><a href="#" class="text-light text-decoration-none">Tin tức</a></li>
                    </ul>
                </div>

                <div class="col-md-4">
                    <h5>Liên hệ</h5>
                    <p>Email: mhkcafe69@gmail.com</p>
                    <p>Hotline: 084 640 9694</p>
                    <p>Giờ mở cửa: 24/24 =P</p>
                </div>
            </div>
            <hr class="bg-light">
            <div class="text-center">
                <p class="mb-0">© 2025 MHK Cafe | Thiết kế bởi Minh, Hưng, Khánh</p>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
